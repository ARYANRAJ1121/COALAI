# COALAI Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_DEBUG=false

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://coalai:coalai@localhost:5432/coalai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Timeout for any single Redis operation (seconds). Keep short — Redis should be sub-ms.
REDIS_TIMEOUT_SECONDS=0.5

# ─── Ollama (primary free/local provider) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Used when no model is specified in the request.
# For CI use qwen2.5:0.5b (faster, less RAM). For dev use llama3.2:3b.
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# ─── Reliability ──────────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_SECONDS=30.0
PROVIDER_STREAMING_TIMEOUT_SECONDS=300.0
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_BACKOFF_FACTOR=2.0
# Fraction of computed delay added as random jitter (±). 0.25 = ±25%.
RETRY_JITTER_FACTOR=0.25

# ─── Auth ─────────────────────────────────────────────────────────────────────
# How long to cache a valid TenantContext in Redis (seconds).
API_KEY_CACHE_TTL_SECONDS=300

# ─── Accounting ───────────────────────────────────────────────────────────────
# PENDING rows older than this are anomalies; reconciliation will promote them.
ACCOUNTING_PENDING_TTL_MINUTES=10
